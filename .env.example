# ===== להעתיק לקובץ .env.local (במחשב) ולהגדרות הסביבה ב Vercel (באוויר) =====
# כל עוד SUPABASE_URL ריק, המערכת לא מחוברת: המסך נקי והכל באפס, ושום דבר לא נשלח.

# סיסמה לכניסה לדשבורד (חובה באוויר)
ADMIN_PASSWORD=

# Supabase: Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend: API Keys (הרשאת Sending access מספיקה)
RESEND_API_KEY=
# Resend: Webhooks > הסוד של ה webhook (מתחיל ב whsec_)
RESEND_WEBHOOK_SECRET=

# סוד ארוך ואקראי שמגן על הקרונים ועל קישורי ההסרה (לא לשנות אחרי שהתחילו לצאת מיילים)
CRON_SECRET=

# הכתובת הציבורית של המערכת אחרי העלאה, למשל https://mail.mybrand.co.il
SITE_URL=
